# Dependencies
node_modules/
.pnp
.pnp.js

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Build output
dist/
build/
client/dist/
server/dist/
*.tsbuildinfo

# Local metadata index (contains your asset list, not the binaries)
server/data/
data/
*.local.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling caches
coverage/
.nyc_output/
.tmp/
.mock-s3/

# Editors & OS cruft
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
