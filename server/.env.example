# ─────────────────────────────────────────────────────────────
# GameVault — server configuration
# Copy this file to `server/.env` and fill in your Filebase keys.
# NEVER commit server/.env. It is git-ignored.
# ─────────────────────────────────────────────────────────────

# Filebase access key (Filebase console → Storage → Access Keys)
FILEBASE_ACCESS_KEY_ID=
# Filebase secret key. Server-side only — never expose it to the browser.
FILEBASE_SECRET_ACCESS_KEY=

# Bucket + endpoint (keep the bucket PRIVATE)
FILEBASE_BUCKET=gaming-asset
FILEBASE_ENDPOINT=https://s3.filebase.io
# Filebase accepts any region string; us-east-1 is the default used by its docs
FILEBASE_REGION=us-east-1

# API port
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Optional ─────────────────────────────────────────────────

# Shared secret that protects the API. STRONGLY recommended before
# exposing GameVault beyond localhost. The UI asks for it once per tab.
# Generate one with: openssl rand -hex 32
GAMEVAULT_AUTH_TOKEN=

# Comma-separated list of browser origins allowed to call the API directly.
# Only needed when the frontend is hosted on a different origin than the API
# (e.g. Vite dev server on :5173). Same-origin production deploys need nothing.
GAMEVAULT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits (bytes). Defaults: 2 GiB per file, multipart above 32 MiB.
MAX_UPLOAD_BYTES=2147483648
MULTIPART_THRESHOLD_BYTES=33554432
MULTIPART_PART_SIZE_BYTES=8388608

# Presigned URL lifetimes (seconds)
PRESIGN_UPLOAD_EXPIRES_SECONDS=900
PRESIGN_DOWNLOAD_EXPIRES_SECONDS=600

# Where the JSON metadata index is stored (defaults to server/data)
# GAMEVAULT_DATA_DIR=./data

# Optional: mirror the metadata index into the bucket so the app survives hosts
# with an ephemeral filesystem (free tiers without a persistent disk).
# Must NOT start with `assets/`. Leave empty to keep the index on local disk only.
# GAMEVAULT_INDEX_OBJECT=_gamevault/index.json

# Path-style addressing. Auto-enabled for non-Filebase endpoints (MinIO/local mocks).
# FILEBASE_FORCE_PATH_STYLE=false
