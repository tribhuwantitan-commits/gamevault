# GameVault — build-time npm settings.
#
# The production build runs TypeScript (and needs @types/node), which live in
# devDependencies. Render sets NODE_ENV=production, and npm then treats an
# install as `--omit=dev`, so `tsc` and `@types/node` go missing and the build
# fails with either:
#     sh: 1: tsc: not found
#     error TS2688: Cannot find type definition file for 'node'.
#
# Forcing dev dependencies to be installed keeps `npm ci && npm run build`
# working regardless of how the host's build command is configured. The running
# server still only loads `dependencies`, and NODE_ENV=production still applies
# at runtime.
include=dev
